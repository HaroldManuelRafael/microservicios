{
  "name": "administration-api",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:http": "vitest run test/http",
    "test:integration": "vitest run --no-file-parallelism test/integration",
    "migration:run": "tsx src/main/run-migration.ts"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2",
    "zod": "^4.1.12"
  }
}
